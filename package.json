{
  "name": "shogi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "engine:setup": "node scripts/setup-engine.mjs",
    "engine:check": "node scripts/engine-smoke.mjs",
    "engine:compare": "node scripts/compare-rules.mjs",
    "vercel-build": "node scripts/setup-engine.mjs && next build && node scripts/verify-engine-bundle.mjs",
    "test:hosted": "playwright test --config playwright.hosted.config.mjs",
    "engine:benchmark": "node scripts/engine-benchmark.mjs"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "@eslint/js": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "@tailwindcss/postcss": "4.3.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
